# =============================================================================
# SGAE — E.E.S. N° 28 "Gustavo Cerati" (Lanús, Provincia de Buenos Aires)
# Variables de entorno de ejemplo (NO colocar credenciales reales aquí)
# =============================================================================

# --- Configuración pública del cliente Firebase (proyecto compartido HOST28_EF) ---
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- URL pública institucional para los códigos QR de validación ---
# Ejemplo: https://sgae-ees28.vercel.app
VITE_PUBLIC_APP_URL=http://localhost:5173

# --- Modo de API privilegiada ('auto' | 'api' | 'firestore') ---
# En Vercel con Firebase Admin configurado, usar 'api' o 'auto'.
VITE_BACKEND_MODE=auto

# =============================================================================
# VARIABLES PRIVADAS DEL SERVIDOR (SOLO VERCEL / BACKEND — NUNCA PREFIJO VITE_)
# =============================================================================

# JSON completo de la Service Account de Firebase Admin (stringificado o base64)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Clave secreta para firmar tokens de sesión del backend (mínimo 32 caracteres)
SGAE_SESSION_SECRET=

# Sal secreta adicional para hashing de tokens de validación
SGAE_TOKEN_PEPPER=
